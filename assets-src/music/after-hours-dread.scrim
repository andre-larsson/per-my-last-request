title    After Hours at the Guild
composer Per My Last ReQuest
about    Sparse dread for a guild that runs on paperwork. The desk barely moves; a trial walks a slow, low pulse, and health at LOW or a red clock each add a layer.
tempo    60
beats    4
steps    2        # 8 steps per bar: one step is an eighth note, half a second
reverb   0.45
key      D phrygian

# A low hum under everything, and a cold draught at the desk. No sea and no bells: that is Brinelight's sound.
bed hum     drone vol=0.4  note=D2 swell=12
bed draught wind  vol=0.2  bright=0.5 swell=9

# Layer 0: always
voice pad    pad      vol=0.32 center=F4 att=2.5 rel=3.5 rev=0.5
voice low    strings  vol=0.17 att=1.2 rel=2.5 pan=-0.1
voice pluck  harp     vol=0.42 center=D3 chance=0.55 jitter=0.25 rev=0.6 pan=0.3
voice choir  choir    vol=0.2  center=A3 att=2.5 rel=3 chance=0.45 pan=-0.25 rev=0.7
voice walk   upright  vol=0.62 gate=0.7
# Layer 1: the hero's health is LOW, or the clock is in the red
voice pulse  timpani  vol=0.5  layer=1
voice high   strings  vol=0.2  layer=1 att=1.5 rel=2 pan=0.2
# Layer 2: both at once
voice drum   bodhran  vol=0.38 layer=2 pan=-0.15
voice horn   horn     vol=0.4  layer=2 att=0.8 rel=1.5
# The stingers' own voices, so they play at any intensity
voice call   horn     vol=0.45 att=0.4 rel=2
voice lament harp     vol=0.45 center=D3 rev=0.6
voice toll   tomlo    vol=0.55

# ------------------------------------------------------------- desk: writing orders, loading, reading the report
pattern desk_A
harmony | Dm | Dm | Eb | Dm |
pad     | [*]?:8 | -:8 | [*]?:8 | [*]?:8 |
low     | D3:8 | A2:8 | G2:8 | D2:8 |
pluck   | {D3 A3 .}:4 {F3 A3 .}:4 | .:4 {A3 D4 .}:4 | Eb3:4 {G3 Bb3 .}:4 | D3:8 |
choir   | _ | _ | {G3 Bb3 .}?:8 | {A3 D4 .}?:8 |

pattern desk_B
harmony | Bb | Gm | Eb | Dm |
pad     | [*]?:8 | [*]?:8 | [*]?:8 | [*]?:8 |
low     | Bb2:8 | G2:8 | Eb2:8 | D2:8 |
pluck   | {D3 F3 .}:4 .:4 | {G3 Bb3 .}:4 .:4 | {Eb3 G3 .}:4 {Bb3 .}:4 | {A3 D3}:8 |
choir   | _ | {D4 G3 .}?:8 | _ | _ |

pattern desk_C
harmony | Dm | Cm | Eb | Dm |
pad     | [*]?:8 | [*]?:8 | [*]?:8 | [*]?:8 |
low     | D3:8 | C3:8 | Bb2:8 | A2:4 D2:4 |
pluck   | .:4 {F3 A3 .}:4 | {C3 G3 .}:4 {Eb3 .}:4 | .:8 | {D3 A3 .}:4 .:4 |
choir   | {A3 F3 .}?:8 | _ | _ | _ |

# Almost nothing: the hum, a soft chord, and the half-step sigh from E flat down to D
pattern desk_D
harmony | Dm | = | Eb | Dm |
pad     | [*]??:8 | -:8 | [*]??:8 | [*]??:8 |
low     | D2:8 | -:8 | _ | _ |
pluck   | _ | _ | {Eb3 .}:8 | {D3 .}:8 |

# ------------------------------------------------------------- trial: walking the circuit and fighting
pattern set_out
harmony | Dm |
walk    | D2:2 .:2 A1:2 D2:2 |
pad     | [*]??:8 |

pattern trial_A
harmony | Dm | Dm | Eb | Dm |
walk    | D2:2 .:2 A1:2 .:2 | D2:2 .:2 C2:2 .:2 | Eb2:2 .:2 Bb1:2 .:2 | D2:2 .:2 A1:2 .:2 |
pad     | [*]??:8 | -:8 | [*]??:8 | [*]??:8 |
pluck   | .:4 {F3 A3 .}:4 | _ | .:4 {G3 Bb3 .}:4 | _ |
pulse   | D2!:2 D2?:2 D2:2 D2?:2 | % | Eb2!:2 Eb2?:2 Eb2:2 Eb2?:2 | D2!:2 D2?:2 D2:2 D2?:2 |
high    | A4:8 | Bb4:8 | Bb4:8 | A4:8 |
drum    | X.x.x.x. | % | % | X.x.xxXX |
horn    | D3:8 | -:8 | Eb3:8 | D3:8 |

pattern trial_B
harmony | Gm | Eb | Cm | Dm |
walk    | G1:2 .:2 D2:2 .:2 | Eb2:2 .:2 Bb1:2 .:2 | C2:2 .:2 G1:2 .:2 | D2:2 .:2 A1:2 Eb2:2 |
pad     | [*]??:8 | [*]??:8 | [*]??:8 | [*]??:8 |
pluck   | {Bb3 D4 .}:4 .:4 | _ | {Eb3 G3 .}:4 .:4 | _ |
pulse   | G2!:2 G2?:2 G2:2 G2?:2 | Eb2!:2 Eb2?:2 Eb2:2 Eb2?:2 | G2!:2 G2?:2 G2:2 G2?:2 | D2!:2 D2?:2 D2:2 D2?:2 |
high    | Bb4:8 | Bb4:8 | G4:8 | A4:8 |
drum    | X.x.x.x. | % | % | X.x.xxXX |
horn    | G3:8 | Eb3:8 | C3:8 | D3:8 |

# trial_A with a low lament in place of the plucks
pattern trial_C from trial_A
low     | F3:8 | A3:4 G3:4 | G3:8 | F3:4 D3:4 |
mute pluck

# trial_B with a distant choir in place of the plucks
pattern trial_D from trial_B
choir   | {D4 Bb3 .}?:8 | _ | {G3 C4 .}?:8 | _ |
mute pluck

# ------------------------------------------------------------- stingers
# Accepted: the dark key lifts to D major for one held chord, then back to the desk.
pattern won
harmony | Bb | Gm | D | = |
pad     | [*]?:8 | [*]?:8 | [*]:8 | -:8 |
low     | Bb2:8 | G2:8 | D2:8 | -:8 |
call    | F3:4 D3:4 | G3:8 | F#3:8 | -:8 |

# Incident: a slow fall to D and two knocks, like a door shutting.
pattern lost
harmony | Gm | Eb | Dm | = |
pad     | [*]?:8 | [*]?:8 | [*]?:8 | -:8 |
low     | G2:8 | Eb2:8 | D2:8 | -:8 |
lament  | D4:2 Bb3:2 G3:4 | Bb3:2 G3:2 Eb3:4 | A3:2 F3:2 D3:4 | .:8 |
toll    | X....... | x....... | X...X... | ........ |

# ------------------------------------------------------------- arrangement
cue desk
beds hum draught
play desk_D
loop desk_A {desk_B desk_C} {desk_D desk_A}

cue trial
beds hum=0.8
play set_out
loop trial_A {trial_B trial_D} trial_C {trial_B trial_D}

cue won
beds hum=0.5
play won
then desk

cue lost
beds hum
play lost
then desk

switch desk -> trial at beat fade 3
switch trial -> desk at bar fade 4
switch * -> won at beat fade 1.5
switch * -> lost at beat fade 1.5
